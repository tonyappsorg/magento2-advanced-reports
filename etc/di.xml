<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Tonyapps\AdvancedReports\Model\ReportPool">
        <arguments>
            <argument name="reports" xsi:type="array">
                <item name="sales_overview" xsi:type="object">Tonyapps\AdvancedReports\Model\Report\SalesOverview</item>
                <item name="sales_by_payment" xsi:type="object">Tonyapps\AdvancedReports\Model\Report\SalesByPayment</item>
                <item name="order_export" xsi:type="object">Tonyapps\AdvancedReports\Model\Report\OrderExport</item>
                <item name="order_items_export" xsi:type="object">Tonyapps\AdvancedReports\Model\Report\OrderItemsExport</item>
            </argument>
        </arguments>
    </type>
    <!-- Tonyapps_EmailDesigner: a starter design for the order export email. Ignored without that module. -->
    <type name="Tonyapps\EmailDesigner\Model\BlockPool">
        <arguments>
            <argument name="starters" xsi:type="array">
                <item name="tonyapps_advancedreports_order_export_email_template" xsi:type="string">Tonyapps_AdvancedReports::view/adminhtml/email_designer/order_export.mjml</item>
            </argument>
        </arguments>
    </type>
</config>
